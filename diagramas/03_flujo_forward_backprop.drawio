exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130.0" y="894.0"/><mxPoint x="130.0" y="304.0"/></Array></mxGeometry></mxCell><mxCell id="c31" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80.0" y="1112.0"/><mxPoint x="80.0" y="222.0"/></Array></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Notación&lt;/b&gt;&lt;br&gt;L: número de capas · l: índice de capa&lt;br&gt;α: tasa de aprendizaje&lt;br&gt;⊙: producto de Hadamard (elemento a elemento)&lt;br&gt;f′: derivada analítica de Sigmoid, ReLU o Linear&lt;br&gt;&lt;br&gt;&lt;b&gt;Costo&lt;/b&gt; (P = número de pesos)&lt;br&gt;forward, backward, predict: O(P)&lt;br&gt;entrenamiento: O(E·N·P)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;fillColor=#F8FAFC;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700.0" y="586" width="300" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
