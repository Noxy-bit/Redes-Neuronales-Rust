s="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110.0" y="788.0"/><mxPoint x="110.0" y="290.0"/></Array></mxGeometry></mxCell><mxCell id="c33" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60.0" y="1096.0"/><mxPoint x="60.0" y="210.0"/></Array></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Notación&lt;/b&gt;&lt;br&gt;N: número de muestras · α: tasa de aprendizaje&lt;br&gt;σ: Sigmoid · softmax: e^zₖ / Σⱼ e^zⱼ&lt;br&gt;δ: gradiente de la pérdida respecto a z&lt;br&gt;&lt;br&gt;&lt;b&gt;Configuración real&lt;/b&gt;&lt;br&gt;lineal: N = 6, α = 0.02, E ≤ 10 000&lt;br&gt;booleano: N = 2, α = 0.5, E = 250&lt;br&gt;vocales: N = 5, α = 0.3, E = 500" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;fillColor=#F8FAFC;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720.0" y="526" width="300" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
