<mxfile host="app.diagrams.net"><diagram name="Flujo de entrenamiento"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c16" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;fillColor=none;strokeWidth=1.5;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="170.0" y="348" width="520" height="478" as="geometry"/></mxCell><mxCell id="c3" value="Inicio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#E2E8F0;strokeWidth=1.5;spacing=6;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340.0" y="0" width="180" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Inicializar la red&lt;/b&gt;&lt;br&gt;Network::new(topología, activaciones, semilla = 42)&lt;br&gt;pesos Xavier/He con SplitMix64 · sesgos b = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="84" width="460" height="78" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Para cada época&lt;/b&gt; e = 1, …, E" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="200" width="460" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Para cada muestra&lt;/b&gt; (x, y) del conjunto de entrenamiento" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="282" width="460" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1. forward&lt;/b&gt;  (propagación hacia adelante)&lt;br&gt;a⁽⁰⁾ = x&lt;br&gt;z⁽ˡ⁾ = W⁽ˡ⁾·a⁽ˡ⁻¹⁾ + b⁽ˡ⁾,   a⁽ˡ⁾ = f(z⁽ˡ⁾),   l = 1, …, L&lt;br&gt;ŷ = a⁽ᴸ⁾" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1D4ED8;fillColor=#DBEAFE;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="364" width="460" height="98" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2. Pérdida&lt;/b&gt;&lt;br&gt;L = MSE(ŷ, y) = (1/n)·Σᵢ (ŷᵢ − yᵢ)²" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#F97316;fillColor=#FFEDD5;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="500" width="460" height="58" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3. backward&lt;/b&gt;  (retropropagación)&lt;br&gt;δ⁽ᴸ⁾ = (2/n)(ŷ − y) ⊙ f′(z⁽ᴸ⁾)&lt;br&gt;δ⁽ˡ⁾ = (W⁽ˡ⁺¹⁾)ᵀ·δ⁽ˡ⁺¹⁾ ⊙ f′(z⁽ˡ⁾)&lt;br&gt;∇W⁽ˡ⁾ = δ⁽ˡ⁾·(a⁽ˡ⁻¹⁾)ᵀ,   ∇b⁽ˡ⁾ = δ⁽ˡ⁾" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#7B2FF7;fillColor=#EDE9FE;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="596" width="460" height="112" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4. update&lt;/b&gt;  (descenso de gradiente)&lt;br&gt;W⁽ˡ⁾ ← W⁽ˡ⁾ − α·∇W⁽ˡ⁾,   b⁽ˡ⁾ ← b⁽ˡ⁾ − α·∇b⁽ˡ⁾" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#047857;fillColor=#D1FAE5;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="746" width="460" height="64" as="geometry"/></mxCell><mxCell id="c11" value="¿Quedan&lt;br&gt;muestras?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FEF9C3;strokeWidth=1.5;spacing=6;rhombus;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330.0" y="848" width="200" height="92" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Registrar la época&lt;/b&gt;: MSE, exactitud, pesos → resultados/*.csv" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="978" width="460" height="50" as="geometry"/></mxCell><mxCell id="c13" value="¿e &amp;lt; E?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FEF9C3;strokeWidth=1.5;spacing=6;rhombus;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330.0" y="1066" width="200" height="92" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Evaluación final&lt;/b&gt; con predict(&amp;amp;self, x): exactitud, matriz de confusión" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="1196" width="460" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Fin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#E2E8F0;strokeWidth=1.5;spacing=6;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340.0" y="1284" width="180" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;train_step(&amp;amp;mut self, x, y, α)&lt;/b&gt;&lt;br&gt;costo O(P) por muestra" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="700.0" y="348" width="240" height="50" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=