<mxfile host="app.diagrams.net"><diagram name="Flujo de entrenamiento del repositorio oficial"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c17" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;fillColor=none;strokeWidth=1.5;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="150.0" y="332" width="560" height="392" as="geometry"/></mxCell><mxCell id="c3" value="Inicio  ·  cargo run -- &amp;lt;experimento&amp;gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#E2E8F0;strokeWidth=1.5;spacing=6;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280.0" y="0" width="300" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Inicializar&lt;/b&gt;&lt;br&gt;Neuron::new(Vector::zeros(n), 0.0)  ·  pesos y bias en cero&lt;br&gt;GradientDescent::new(α)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="82" width="500" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Para cada época&lt;/b&gt; e = 1, …, E  ·  acumuladores ∇w = 0, ∇b = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="188" width="500" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Para cada muestra&lt;/b&gt; (x, y) del conjunto fijo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="268" width="500" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1. forward&lt;/b&gt;  Neuron::forward / Layer::forward&lt;br&gt;z = x · w + b" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1E3A8A;fillColor=#E8EDF5;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="348" width="500" height="58" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2. Salida&lt;/b&gt;&lt;br&gt;lineal: ŷ = z   ·   booleano: p = σ(z)   ·   vocales: p = softmax(z)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#374151;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="442" width="500" height="58" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3. Error por muestra&lt;/b&gt;&lt;br&gt;lineal: δ = MSE′(ŷ, y) / N = 2(ŷ − y) / N&lt;br&gt;booleano y vocales: δ = (p − y) / N" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#E8EDF5;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="536" width="500" height="78" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4. Acumular&lt;/b&gt;  Gradient::weights / Gradient::bias&lt;br&gt;∇w += δ · x,   ∇b += δ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#E8EDF5;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="650" width="500" height="58" as="geometry"/></mxCell><mxCell id="c11" value="¿Quedan&lt;br&gt;muestras?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;rhombus;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330.0" y="744" width="200" height="88" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;5. Actualizar una vez por época&lt;/b&gt;  GradientDescent&lt;br&gt;w ← w − α·∇w,   b ← b − α·∇b" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#15803D;fillColor=#ECF5EF;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="868" width="500" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Informar&lt;/b&gt;: parámetros, MSE o probabilidades por época (stdout)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="964" width="500" height="46" as="geometry"/></mxCell><mxCell id="c14" value="¿e &amp;lt; E y no&lt;br&gt;se alcanzó la meta?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;rhombus;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315.0" y="1046" width="230" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Resultado final&lt;/b&gt;: predicciones, clase reconocida y confianza" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="180.0" y="1182" width="500" height="46" as="geometry"/></mxCell><mxCell id="c16" value="Fin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#E2E8F0;strokeWidth=1.5;spacing=6;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340.0" y="1264" width="180" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Cuerpo del ciclo interno&lt;/b&gt;&lt;br&gt;escrito en cada experimento" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="720.0" y="332" width="240" height="50" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5