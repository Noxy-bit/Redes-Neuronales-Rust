<mxfile host="app.diagrams.net"><diagram name="Árbol de problemas"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="EFECTO&lt;br&gt;FINAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#0F2A5F;strokeWidth=1.5;spacing=6;fontStyle=1;fontSize=12;fontColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="140" height="70" as="geometry"/></mxCell><mxCell id="c4" value="EFECTOS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#0F2A5F;strokeWidth=1.5;spacing=6;fontStyle=1;fontSize=12;fontColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="0" y="130" width="140" height="110" as="geometry"/></mxCell><mxCell id="c5" value="PROBLEMA&lt;br&gt;CENTRAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#B91C1C;fillColor=#B91C1C;strokeWidth=1.5;spacing=6;fontStyle=1;fontSize=12;fontColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="140" height="100" as="geometry"/></mxCell><mxCell id="c6" value="CAUSAS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#334155;fillColor=#334155;strokeWidth=1.5;spacing=6;fontStyle=1;fontSize=12;fontColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="0" y="460" width="140" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Profesionales que usan la IA como usuarios de herramientas, no como constructores capaces de explicarla, adaptarla y optimizarla&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#E2E8F0;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="20" width="1120" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;La formación inicial en redes neuronales se apoya en frameworks de «caja negra»: los estudiantes entrenan modelos sin comprender sus fundamentos matemáticos ni computacionales&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#B91C1C;fillColor=#FEE2E2;strokeWidth=1.5;spacing=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="170" y="300" width="1120" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Comprensión superficial de la propagación hacia adelante, la retropropagación y el descenso de gradiente" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#EEF2F7;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="130" width="250" height="110" as="geometry"/></mxCell><mxCell id="c10" value="Los frameworks de alto nivel (TensorFlow, PyTorch) ocultan el álgebra lineal y el cálculo detrás de llamadas de una línea" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#334155;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="460" width="250" height="130" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.1116;entryY=1;" edge="1" parent="1" source="c10" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.1116;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.1116;entryY=1;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Dificultad para depurar modelos, elegir hiperparámetros (α, épocas, capas) e interpretar la pérdida" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#EEF2F7;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="250" height="110" as="geometry"/></mxCell><mxCell id="c15" value="La enseñanza se centra en el uso de herramientas y no en la derivación matemática ni en su implementación" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#334155;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="460" width="250" height="130" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.3705;entryY=1;" edge="1" parent="1" source="c15" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.3705;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.3705;entryY=1;" edge="1" parent="1" source="c14" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Dependencia de librerías externas, servicios en la nube y hardware costoso para experimentar" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#EEF2F7;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="130" width="250" height="110" as="geometry"/></mxCell><mxCell id="c20" value="Pocos materiales didácticos abiertos, en español, que construyan una red neuronal paso a paso desde cero" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#334155;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="460" width="250" height="130" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.6295;entryY=1;" edge="1" parent="1" source="c20" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.6295;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" val