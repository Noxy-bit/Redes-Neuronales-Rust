lor=#0F172A;strokeColor=#1D4ED8;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;spacingLeft=8;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="390" height="34" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;x: Vector&lt;/b&gt;  (entrada de una muestra)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="390" height="26" as="geometry"/></mxCell><mxCell id="c9" value="data: Vec&amp;lt;f64&amp;gt;  { ptr ●, len = 2, cap = 2 }" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1D4ED8;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;spacingLeft=8;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="203" width="390" height="34" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;alpha: f64 = 0.5&lt;/b&gt;  (Copy: vive completo en el stack)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="265" width="390" height="26" as="geometry"/></mxCell><mxCell id="c11" value="Un Vec&amp;lt;T&amp;gt; ocupa 24 B en el stack (puntero, longitud y capacidad); sus elementos viven contiguos en el heap." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="390" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Buffer de Vec&amp;lt;Layer&amp;gt;&lt;/b&gt;  (2 capas contiguas)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=H