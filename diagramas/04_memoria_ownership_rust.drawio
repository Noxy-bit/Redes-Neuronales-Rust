ont&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#CFFAFE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="736" y="285" width="72" height="54" as="geometry"/></mxCell><mxCell id="c23" value="w&lt;sub&gt;20&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[4]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#E0F2FE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="808" y="285" width="72" height="54" as="geometry"/></mxCell><mxCell id="c24" value="w&lt;sub&gt;21&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[5]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#E0F2FE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="880" y="285" width="72" height="54" as="geometry"/></mxCell><mxCell id="c25" value="w&lt;sub&gt;30&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[6]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#CFFAFE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="952" y="285" width="72" height="54" as="geometry"/></mxCell><mxCell id="c26" value="w&lt;sub&gt;31&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[7]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#CFFAFE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1024" y="285" width="72" height="54" as="geometry"/></mxCell><mxCell id="c27" value="idx(i, j) = i·cols + j   →   W[i][j] = data[i·2 + j]   ·   recorrido secuencial amigable con la caché" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="520" y="345" width="780" height="26" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Datos de x&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1120" y="40" width="180" height="26" as="geometry"/></mxCell><mxCell id="c29" value="x&lt;sub&gt;1&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#E0F2FE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1120" y="68" width="80" height="44" as="geometry"/></mxCell><mxCell id="c30" value="x&lt;sub&gt;2&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#E0F2FE;strokeWidth=1.5;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1200" y="68" width="80" height="44" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;endArrow=classic;endFill=1;strokeWidth=1.6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;endArrow=classic;endFill=1;strokeWidth=1.6;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c9" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="220"/><mxPoint x="460" y="420"/><mxPoint x="1160" y="420"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontSize=12;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;endArrow=classic;endFill=1;strokeWidth=1.6;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="113"/><mxPoint x="940" y="240"/><mxPoint x="556" y="240"/></Array></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Ownership&lt;/b&gt;&lt;br&gt;Network posee su Vec&amp;lt;Layer&amp;gt;; cada Layer posee sus Matrix y Vector. Cuando red sale de ámbito, Drop libera todo el heap en cascada: sin recolector de basura y sin fugas." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1D4ED8;fillColor=#DBEAFE;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="315" height="120" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Préstamo inmutable  &amp;amp;T&lt;/b&gt;&lt;br&gt;predict(&amp;amp;self, x: &amp;amp;Vector) y evaluate_mse(&amp;amp;self, …) solo leen: admiten varios lectores a la vez y no copian los datos." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#047857;fillColor=#D1FAE5;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="500" width="315" height="120" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Préstamo mutable  &amp;amp;mut T&lt;/b&gt;&lt;br&gt;forward, backward, update y train_step(&amp;amp;mut self, …) modifican pesos y cachés: un único escritor; el compilador impide alias con mutación." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#7B2FF7;fillColor=#EDE9FE;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="500" width="315" height="120" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Result&amp;lt;T, MathError&amp;gt;&lt;/b&gt;&lt;br&gt;get(i, j), matmul o add validan índices y dimensiones y devuelven Err en lugar de acceder fuera de rango o entrar en pánico." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#F97316;fillColor=#FFEDD5;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1005" y="500" width="315" height="120" as="geometry"/></mxCell><mxCell id="c38" value="● puntero (ptr) del Vec hacia su buffer en el heap" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F1736;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="0" y="630" width="420" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
