<mxfile host="app.diagrams.net"><diagram name="Fases de la metodología"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Fundamentos matemáticos&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#ECFEFF;strokeWidth=1.5;spacing=6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="-12" y="6" width="1112" height="236" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Aprendizaje&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1D4ED8;fillColor=#EFF6FF;strokeWidth=1.5;spacing=6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="-12" y="296" width="540" height="236" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Experimentación&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#7B2FF7;fillColor=#FAF5FF;strokeWidth=1.5;spacing=6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="296" width="540" height="236" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Difusión&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#F97316;fillColor=#FFF7ED;strokeWidth=1.5;spacing=6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1132" y="296" width="254" height="236" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 1 · Matemática&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Vector y Matrix: acceso seguro, suma, resta, producto punto, Hadamard, matmul y transpuesta&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#0891B2&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Base de álgebra lineal probada&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="230" height="190" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 2 · Neurona&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Neuron con pesos, sesgo y forward: z = w·x + b, a = f(z)&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#0891B2&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Una neurona calcula su salida&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="40" width="230" height="190" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 3 · Activaciones&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Sigmoid, ReLU y Linear con derivadas analíticas&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#0891B2&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Activaciones verificadas&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="572" y="40" width="230" height="190" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;background:#0891B2;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 4 · Error&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;MSE y su gradiente ∂L/∂ŷ&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#0891B2&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Medida de la diferencia salida–objetivo&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0891B2;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="858" y="40" width="230" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;background:#1D4ED8;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 5 · Primer aprendizaje&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Gradientes y descenso de gradiente sobre y = 2x&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#1D4ED8&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; El error disminuye: w → 2&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1D4ED8;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="330" width="230" height="190" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;background:#1D4ED8;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 6 · Capas y red&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Layer y Network: forward, backward, predict y train; gradient checking&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#1D4ED8&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Red multicapa operativa&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1D4ED8;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="330" width="230" height="190" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;background:#7B2FF7;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 7 · XOR&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Perceptrón 2-1 vs. red 2-4-1 y tres tasas de aprendizaje&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#7B2FF7&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Aprendizaje no lineal demostrado&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#7B2FF7;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="572" y="330" width="230" height="190" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;background:#7B2FF7;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 8 · Vocales&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Matrices 5×5 de A, E, I, O, U con ruido; red 25-10-5&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px;color:#7B2FF7&quot;&gt;&lt;b&gt;Resultado:&lt;/b&gt; Clasificación, exactitud y matriz de confusión&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#7B2FF7;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="858" y="330" width="230" height="190" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;background:#F97316;color:#FFFFFF;padding:4px;border-radius:4px&quot;&gt;&lt;b&gt;Fase 9 · Documentación&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;margin-top:6px&quot;&gt;Documentación ///, prueba de escritorio, benchmarks, tesis APA 7 y kit de 