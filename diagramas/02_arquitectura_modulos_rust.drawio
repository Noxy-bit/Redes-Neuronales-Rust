<mxfile host="app.diagrams.net"><diagram name="Arquitectura del repositorio oficial lanorrron/neural-network"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;main.rs — CLI&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;cargo run [-- lineal | booleano | vocal &amp;lt;letra&amp;gt;]&lt;br&gt;sin argumento: experimento de vocales&lt;hr style=&quot;margin:3px 0&quot;&gt;+ main(): match args.first() → experiments::*::run()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F1F5F9;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="420" y="0" width="500" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Motor de validación complementario&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;Noxy-bit/Redes-Neuronales-Rust (f64, std)&lt;hr style=&quot;margin:3px 0&quot;&gt;XOR 2-4-1 con retropropagación multicapa&lt;br&gt;52 pruebas · gradient checking · benchmarks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="0" width="420" height="110" as="geometry"/></mxCell><mxCell id="c5" value="experiments  (src/experiments/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#374151;fillColor=#F8FAFC;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="1420" height="200" as="geometry"/></mxCell><mxCell id="c6" value="neural  (src/neural/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F8FAFC;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="420" width="900" height="290" as="geometry"/></mxCell><mxCell id="c7" value="learning  (src/learning/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#F8FAFC;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="480" height="290" as="geometry"/></mxCell><mxCell id="c8" value="math  (src/math/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#334155;fillColor=#F8FAFC;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="0" y="770" width="1420" height="200" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;linear.rs · run()&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;Aprender y = 2x · 1 neurona lineal&lt;br&gt;6 muestras · α = 0.02 · meta MSE ≤ 10⁻¹²&lt;hr style=&quot;margin:3px 0&quot;&gt;gradiente de lote completo (MSE)&lt;br&gt;informe cada 20 épocas" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="195" width="445" height="145" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;true_false.rs · run()&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;0 → falso · 1 → verdadero&lt;br&gt;Sigmoid · umbral 0.5 · α = 0.5 · 250 épocas&lt;hr style=&quot;margin:3px 0&quot;&gt;gradiente (p − y) / N&lt;br&gt;traza ∇w, ∇b, Δw, Δb por época" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="487" y="195" width="445" height="145" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;vowels.rs · run(Option&amp;lt;&amp;amp;str&amp;gt;)&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;Vocales A·E·I·O·U en 5×5 → 25 entradas&lt;br&gt;Layer 25 → 5 · softmax · α = 0.3 · 500 épocas&lt;hr style=&quot;margin:3px 0&quot;&gt;encode · softmax · argmax · parse_vowel&lt;br&gt;gradiente (p − y) / N por salida" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#374151;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="954" y="195" width="445" height="145" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Network&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;- layers: Vec&amp;lt;Layer&amp;gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;+ new(layers)&lt;br&gt;+ forward(&amp;amp;self, x) → Vector" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="260" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Layer&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;- neurons: Vec&amp;lt;Neuron&amp;gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;+ new(neurons)&lt;br&gt;+ forward(&amp;amp;self, x) → Vector&lt;br&gt;+ neurons_mut() → &amp;amp;mut [Neuron]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="320" y="460" width="270" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Neuron&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;- weights: Vector&amp;lt;f32&amp;gt;&lt;br&gt;- bias: f32&lt;hr style=&quot;margin:3px 0&quot;&gt;+ forward(x) = x · w + b&lt;br&gt;+ weights(_mut), bias(_mut)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="630" y="460" width="250" height="130" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Activacion&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;relu(v) = max(0, v)&lt;br&gt;sigmoid(v) = 1 / (1 + e⁻ᵛ)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#E8EDF5;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="630" y="600" width="250" height="76" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;MSE&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;calculate(ŷ, y) = (1/n)·Σ(ŷ − y)²&lt;hr style=&quot;margin:3px 0&quot;&gt;derivate(ŷ, y) = 2(ŷ − y)/n" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="440" height="76" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Gradient&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;weights(δ, x) = δ·xᵢ  ·  bias(δ) = δ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="960" y="548" width="440" height="56" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;GradientDescent&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;- learning_rate: f32&lt;hr style=&quot;margin:3px 0&quot;&gt;update_weights(w, ∇) · update_bias(b, ∇)  →  θ ← θ − α∇" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#0F2A5F;fillColor=#FFFFFF;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="960" y="614" width="440" height="84" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Vector&amp;lt;T&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;- data: Vec&amp;lt;T&amp;gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;+ new, zeros, len, get, set, as_slice(_mut)&lt;br&gt;+ add, sub, multiply_scalar, dot, map&lt;br&gt;+ random(n)